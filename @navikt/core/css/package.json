{
  "name": "@navikt/ds-css",
  "version": "8.16.1",
  "description": "CSS for Nav Designsystem",
  "author": "Aksel | Nav designsystem team",
  "keywords": [
    "css"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "*",
    "!dist/version",
    "!config",
    "!.gitignore",
    "!CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/navikt/aksel.git",
    "directory": "@navikt/core/css"
  },
  "bugs": {
    "url": "https://github.com/navikt/aksel/issues"
  },
  "homepage": "https://aksel.nav.no/designsystemet/",
  "scripts": {
    "build": "tsx ./config/bundle.ts",
    "css:get-version": "node config/get-version.js"
  },
  "devDependencies": {
    "@navikt/ds-tokens": "^8.16.1",
    "browserslist": "^4.28.7",
    "esbuild": "^0.28.0",
    "fast-glob": "3.3.3",
    "lightningcss": "^1.33.0",
    "tsx": "^4.23.1"
  },
  "browserslist": [
    ">= 0.2% in NO",
    "not safari < 15.4",
    "not ios_saf < 15.4",
    "not dead"
  ],
  "main": "./dist/index.css",
  "exports": {
    ".": {
      "types": "./types.d.ts",
      "default": "./dist/index.css"
    },
    "./dist/*": {
      "types": "./types.d.ts",
      "default": "./dist/*"
    }
  }
}
