{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "jsx-a11y",
    "import",
    "vitest"
  ],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "**/lib",
    "**/public",
    "**/esm",
    "**/cjs",
    "**/dist",
    "**/.next",
    "**/.build",
    "**/coverage",
    "**/storybook-static",
    "**/test-results",
    "**/playwright-report",
    "**/.sanity/runtime",
    "**/next-env.d.ts",
    "**/codemod/**/*.js",
    "**/transforms/**/*.input.*",
    "**/transforms/**/*.output.*",
    "@navikt/aksel/**/*.input.*",
    "@navikt/aksel/**/*.output.*",
    "**/modal/helpers/dialog-polyfill.ts",
    "**/query-types.ts",
    "**/component-names.generated.ts",
    "**/tokens/**/plugin.js",
    "@navikt/aksel-icons/src",
    "@navikt/aksel/src/version.ts",
    "@navikt/core/tailwind/src/tokens.ts",
    "@navikt/core/tailwind/tailwind.config.js",
    "@navikt/core/tailwind/tailwind.darkside.config.js",
    "@navikt/core/tokens/token_docs.js",
    "apps/playroom/playroom.config.js",
    "apps/playroom/src/auto-generated-imports.ts",
    "apps/figma-icon-plugin/src/ui/vite-env.d.ts",
    "tooling/analyzer/temp",
    ".yarn"
  ],
  "rules": {
    "jsx-a11y/alt-text": "error",
    "jsx-a11y/anchor-ambiguous-text": "error",
    "jsx-a11y/anchor-has-content": "error",
    "jsx-a11y/anchor-is-valid": "error",
    "jsx-a11y/aria-activedescendant-has-tabindex": "error",
    "jsx-a11y/aria-props": "error",
    "jsx-a11y/aria-proptypes": "error",
    "jsx-a11y/aria-role": "error",
    "jsx-a11y/aria-unsupported-elements": "error",
    "jsx-a11y/autocomplete-valid": "error",
    "jsx-a11y/click-events-have-key-events": "error",
    "jsx-a11y/heading-has-content": "error",
    "jsx-a11y/html-has-lang": "error",
    "jsx-a11y/iframe-has-title": "error",
    "jsx-a11y/img-redundant-alt": "error",
    "jsx-a11y/interactive-supports-focus": "error",
    "jsx-a11y/label-has-associated-control": "error",
    "jsx-a11y/lang": "error",
    "jsx-a11y/media-has-caption": "error",
    "jsx-a11y/mouse-events-have-key-events": "error",
    "jsx-a11y/no-access-key": "error",
    "jsx-a11y/no-aria-hidden-on-focusable": "error",
    "jsx-a11y/no-autofocus": "error",
    "jsx-a11y/no-distracting-elements": "error",
    "jsx-a11y/no-interactive-element-to-noninteractive-role": "error",
    "jsx-a11y/no-noninteractive-element-to-interactive-role": "error",
    "jsx-a11y/no-noninteractive-tabindex": "error",
    "jsx-a11y/no-redundant-roles": "error",
    "jsx-a11y/no-static-element-interactions": "error",
    "jsx-a11y/prefer-tag-over-role": "off",
    "jsx-a11y/role-has-required-aria-props": "error",
    "jsx-a11y/role-supports-aria-props": "error",
    "jsx-a11y/scope": "error",
    "jsx-a11y/tabindex-no-positive": "error",
    "react/button-has-type": "error",
    "eslint/no-extra-label": "warn",
    "eslint/no-lone-blocks": "warn",
    "eslint/no-sequences": "warn",
    "eslint/no-unneeded-ternary": "warn",
    "eslint/no-useless-computed-key": "warn",
    "eslint/no-useless-constructor": "warn",
    "eslint/no-useless-rename": "warn",
    "eslint/prefer-numeric-literals": "warn",
    "eslint/prefer-regex-literals": "warn",
    "eslint/prefer-rest-params": "warn",
    "react/jsx-no-useless-fragment": [
      "warn",
      {
        "allowExpressions": true
      }
    ],
    "typescript/no-useless-empty-export": "warn",
    "unicorn/no-static-only-class": "warn",
    "unicorn/no-useless-switch-case": "warn",
    "unicorn/prefer-array-flat": "warn",
    "unicorn/prefer-array-flat-map": "warn",
    "unicorn/prefer-array-index-of": "warn",
    "unicorn/prefer-date-now": "warn",
    "eslint/no-constructor-return": "error",
    "eslint/no-inner-declarations": [
      "error",
      "both",
      {
        "blockScopedFunctions": "allow"
      }
    ],
    "eslint/no-use-before-define": [
      "error",
      {
        "functions": false,
        "classes": false,
        "variables": false,
        "enums": false,
        "typedefs": false,
        "ignoreTypeReferences": true,
        "allowNamedExports": true
      }
    ],
    "eslint/radix": "warn",
    "oxc/bad-min-max-func": "error",
    "react/void-dom-elements-no-children": "error",
    "import/namespace": "warn",
    "oxc/no-accumulating-spread": "warn",
    "eslint/no-eval": "error",
    "eslint/no-script-url": "error",
    "react/jsx-no-script-url": "error",
    "react/no-danger": "error",
    "eslint/prefer-const": "warn",
    "eslint/prefer-exponentiation-operator": "warn",
    "eslint/prefer-template": "warn",
    "typescript/consistent-type-imports": [
      "warn",
      {
        "disallowTypeAnnotations": false
      }
    ],
    "typescript/no-non-null-assertion": "warn",
    "typescript/prefer-function-type": "warn",
    "typescript/prefer-literal-enum-member": "warn",
    "unicorn/prefer-node-protocol": "warn",
    "eslint/array-callback-return": [
      "error",
      {
        "checkForEach": true,
        "allowVoid": true
      }
    ],
    "eslint/default-case-last": "warn",
    "eslint/eqeqeq": [
      "error",
      "always",
      {
        "null": "ignore"
      }
    ],
    "eslint/no-label-var": "error",
    "eslint/no-labels": [
      "warn",
      {
        "allowLoop": true
      }
    ],
    "eslint/no-proto": "warn",
    "eslint/no-self-compare": "error",
    "eslint/no-template-curly-in-string": "warn",
    "oxc/approx-constant": "warn",
    "oxc/misrefactored-assign-op": "error",
    "oxc/no-const-enum": "warn",
    "react/no-array-index-key": "error",
    "typescript/adjacent-overload-signatures": "warn",
    "typescript/no-invalid-void-type": "warn",
    "unicorn/no-document-cookie": "warn",
    "unicorn/no-instanceof-array": "warn",
    "unicorn/no-thenable": "error",
    "unicorn/prefer-number-properties": "off",
    "eslint/no-console": [
      "warn",
      {
        "allow": [
          "info",
          "warn",
          "error",
          "group",
          "groupEnd",
          "table",
          "assert",
          "countReset",
          "count",
          "dir",
          "time",
          "timeEnd",
          "timeStamp"
        ]
      }
    ],
    "eslint/no-else-return": [
      "error",
      {
        "allowElseIf": false
      }
    ],
    "eslint/no-shadow": [
      "error",
      {
        "ignoreTypeValueShadow": true,
        "ignoreFunctionTypeParameterNameValueShadow": true
      }
    ],
    "eslint/object-shorthand": ["error", "always"],
    "typescript/array-type": "off",
    "vitest/require-mock-type-parameters": "off",
    "vitest/require-to-throw-message": "off",
    "typescript/no-explicit-any": "off",
    "unicorn/no-array-for-each": "off",
    "import/no-cycle": "off",
    "react/refs": "off",
    "eslint/constructor-super": "off",
    "eslint/for-direction": "off",
    "eslint/getter-return": "off",
    "eslint/no-async-promise-executor": "off",
    "eslint/no-class-assign": "off",
    "eslint/no-compare-neg-zero": "off",
    "eslint/no-cond-assign": "off",
    "eslint/no-const-assign": "off",
    "eslint/no-constant-binary-expression": "off",
    "eslint/no-constant-condition": "off",
    "eslint/no-control-regex": "off",
    "eslint/no-debugger": "off",
    "eslint/no-delete-var": "off",
    "eslint/no-dupe-class-members": "off",
    "eslint/no-dupe-else-if": "off",
    "eslint/no-dupe-keys": "off",
    "eslint/no-duplicate-case": "off",
    "eslint/no-empty-character-class": "off",
    "eslint/no-empty-pattern": "off",
    "eslint/no-empty-static-block": "off",
    "eslint/no-ex-assign": "off",
    "eslint/no-extra-boolean-cast": "off",
    "eslint/no-func-assign": "off",
    "eslint/no-global-assign": "off",
    "eslint/no-import-assign": "off",
    "eslint/no-invalid-regexp": "off",
    "eslint/no-irregular-whitespace": "off",
    "eslint/no-loss-of-precision": "off",
    "eslint/no-misleading-character-class": "off",
    "eslint/no-new-native-nonconstructor": "off",
    "eslint/no-nonoctal-decimal-escape": "off",
    "eslint/no-obj-calls": "off",
    "eslint/no-self-assign": "off",
    "eslint/no-setter-return": "off",
    "eslint/no-shadow-restricted-names": "off",
    "eslint/no-sparse-arrays": "off",
    "eslint/no-this-before-super": "off",
    "eslint/no-unassigned-vars": "off",
    "eslint/no-unreachable": "off",
    "eslint/no-unsafe-finally": "off",
    "eslint/no-unsafe-negation": "off",
    "eslint/no-unsafe-optional-chaining": "off",
    "eslint/no-unused-expressions": "off",
    "eslint/no-unused-labels": "off",
    "eslint/no-unused-private-class-members": "off",
    "eslint/no-unused-vars": "off",
    "eslint/no-useless-backreference": "off",
    "eslint/no-useless-catch": "off",
    "eslint/no-useless-escape": "off",
    "eslint/no-with": "off",
    "eslint/require-yield": "off",
    "eslint/use-isnan": "off",
    "eslint/valid-typeof": "off",
    "import/default": "off",
    "react/error-boundaries": "off",
    "react/exhaustive-deps": "off",
    "react/globals": "off",
    "react/immutability": "off",
    "react/incompatible-library": "off",
    "react/jsx-key": "off",
    "react/jsx-no-duplicate-props": "off",
    "react/jsx-no-undef": "off",
    "react/no-children-prop": "off",
    "react/no-danger-with-children": "off",
    "react/no-direct-mutation-state": "off",
    "react/no-find-dom-node": "off",
    "react/no-is-mounted": "off",
    "react/no-render-return-value": "off",
    "react/no-string-refs": "off",
    "react/preserve-manual-memoization": "off",
    "react/purity": "off",
    "react/set-state-in-effect": "off",
    "react/set-state-in-render": "off",
    "react/static-components": "off",
    "react/use-memo": "off",
    "react/void-use-memo": "off",
    "typescript/no-duplicate-enum-values": "off",
    "typescript/no-extra-non-null-assertion": "off",
    "typescript/no-misused-new": "off",
    "typescript/no-non-null-asserted-optional-chain": "off",
    "typescript/no-this-alias": "off",
    "typescript/no-unsafe-declaration-merging": "off",
    "typescript/no-wrapper-object-types": "off",
    "typescript/prefer-as-const": "off",
    "typescript/prefer-namespace-keyword": "off",
    "typescript/triple-slash-reference": "off",
    "vitest/no-duplicate-hooks": "error",
    "vitest/expect-expect": "off",
    "vitest/no-conditional-expect": "off",
    "vitest/no-disabled-tests": "off",
    "vitest/no-focused-tests": "off",
    "vitest/no-standalone-expect": "off",
    "vitest/require-local-test-context-for-concurrent-snapshots": "off",
    "vitest/valid-describe-callback": "off",
    "vitest/valid-expect": "off",
    "vitest/valid-expect-in-promise": "off",
    "vitest/valid-title": "off"
  },
  "overrides": [
    {
      "files": ["**/*.stories.ts", "**/*.stories.tsx", "scripts/*.ts"],
      "rules": {
        "eslint/no-console": "off"
      }
    }
  ]
}
