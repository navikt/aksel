{
  "name": "aksel-sanity-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Aksel.nav.no sanity studio",
  "author": "Aksel | Nav designsystem team",
  "scripts": {
    "dev": "yarn sanity dev",
    "build": "yarn type-check",
    "test": "yarn vitest run && yarn type-check",
    "sanity:backup": "yarn tsx --env-file-if-exists=.env sanity.backup.ts",
    "update:sanity-schema": "yarn sanity schema extract --workspace default --path ./.sanity/sanity-schema.json && yarn update:sanity-typegen",
    "update:sanity-typegen": "yarn sanity typegen generate",
    "update:sanity-manifest": "yarn sanity schema deploy --workspace default --manifest-dir ../website/public/studio/static",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@portabletext/react": "^8.0.1",
    "@sanity/client": "8.6.2",
    "@sanity/code-input": "7.3.8",
    "@sanity/color-input": "6.1.4",
    "@sanity/image-url": "2.1.1",
    "@sanity/locale-nb-no": "1.1.39",
    "@sanity/preview-url-secret": "4.1.5",
    "@sanity/table": "3.1.16",
    "@sanity/vision": "6.13.1",
    "date-fns": "^4.0.0",
    "lodash": "4.18.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-rx": "^5.1.1",
    "rxjs": "^7.8.2",
    "sanity": "6.13.1",
    "sanity-plugin-iframe-pane": "5.0.36",
    "sanity-plugin-media": "6.2.0",
    "sanity-plugin-references": "1.2.0",
    "styled-components": "6.4.4",
    "swr": "^2.4.2"
  },
  "devDependencies": {
    "@sanity/blueprints": "0.24.0",
    "@sanity/export": "6.2.1",
    "@sanity/functions": "1.7.2",
    "@sanity/schema": "6.13.1",
    "@types/lodash": "4.17.20",
    "@types/react": "19.2.14",
    "tsx": "^4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "exports": {
    "./schema": {
      "types": "./schema/schema.config.ts",
      "import": "./schema/schema.config.ts",
      "default": "./schema/schema.config.ts"
    },
    "./env": {
      "types": "./sanity.env.ts",
      "import": "./sanity.env.ts",
      "default": "./sanity.env.ts"
    },
    "./studio-config": {
      "types": "./sanity.config.ts",
      "import": "./sanity.config.ts",
      "default": "./sanity.config.ts"
    }
  }
}
