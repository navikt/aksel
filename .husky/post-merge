CHANGED=`git diff HEAD@{1} --stat -- yarn.lock | wc -l`
if [ $CHANGED -gt 0 ];
then
    printf '\n\033[1;33m'
    printf '  ╔══════════════════════════════════════════╗\n'
    printf '  ║                                          ║\n'
    printf '  ║   !!  yarn.lock has changed  !!          ║\n'
    printf '  ║                                          ║\n'
    printf '  ║   Run: yarn install                      ║\n'
    printf '  ║                                          ║\n'
    printf '  ╚══════════════════════════════════════════╝\n'
    printf '\033[0m\n'
fi
