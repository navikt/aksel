{
  "name": "aksel-sanity-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Aksel.nav.no sanity studio",
  "author": "Aksel | Nav designsystem team",
  "scripts": {
    "dev": "yarn sanity dev",
    "build": "yarn type-check",
    "test": "yarn vitest run && yarn type-check",
    "sanity:backup": "yarn tsx --env-file-if-exists=.env sanity.backup.ts",
    "update:sanity-schema": "yarn sanity schema extract --workspace default --path ./.sanity/sanity-schema.json && yarn update:sanity-typegen",
    "update:sanity-typegen": "yarn sanity typegen generate",
    "update:sanity-manifest": "yarn sanity schema deploy --workspace default --manifest-dir ../website/public/studio/static",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@portabletext/react": "^8.0.1",
    "@sanity/client": "7.27.0",
    "@sanity/code-input": "7.3.16",
    "@sanity/color-input": "6.1.10",
    "@sanity/image-url": "2.2.0",
    "@sanity/locale-nb-no": "1.1.39",
    "@sanity/preview-url-secret": "4.1.5",
    "@sanity/table": "3.1.21",
    "@sanity/vision": "6.24.0",
    "date-fns": "^4.0.0",
    "lodash": "4.18.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-rx": "7.1.0",
    "rxjs": "^7.8.2",
    "sanity": "6.24.0",
    "sanity-plugin-iframe-pane": "5.0.43",
    "sanity-plugin-media": "6.6.3",
    "sanity-plugin-references": "1.2.0",
    "styled-components": "6.6.0",
    "swr": "^2.4.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@sanity/blueprints": "0.34.1",
    "@sanity/export": "7.1.1",
    "@sanity/functions": "1.11.0",
    "@sanity/schema": "6.24.0",
    "@types/lodash": "4.17.25",
    "@types/react": "19.2.14",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  },
  "exports": {
    "./schema": {
      "types": "./schema/schema.config.ts",
      "import": "./schema/schema.config.ts",
      "default": "./schema/schema.config.ts"
    },
    "./env": {
      "types": "./sanity.env.ts",
      "import": "./sanity.env.ts",
      "default": "./sanity.env.ts"
    },
    "./newsletter-schema": {
      "types": "./structure/newsletter/newsletter-schema.ts",
      "import": "./structure/newsletter/newsletter-schema.ts",
      "default": "./structure/newsletter/newsletter-schema.ts"
    },
    "./studio-config": {
      "types": "./sanity.config.ts",
      "import": "./sanity.config.ts",
      "default": "./sanity.config.ts"
    }
  }
}
